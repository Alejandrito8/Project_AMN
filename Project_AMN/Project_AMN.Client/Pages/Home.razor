@page "/"
@rendermode InteractiveWebAssembly

@using Microsoft.AspNetCore.Components.Web

<PageTitle>Marketplace AB</PageTitle>

<div class="container container-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1>Welcome to Marketplace AB</h1>
            <p>Discover and explore a variety of products and deals all in one place!</p>
        </div>
    </div>

    <div class="gray-rects">
        <div class="gray-rect">
            <div>
                <h3>Latest Electronics</h3>
                <p>Check out the newest gadgets and technology at unbeatable prices!</p>
            </div>
        </div>

        <div class="gray-rect">
            <div>
                <h3>Fashion & Accessories</h3>
                <p>Explore the latest trends and style your wardrobe today!</p>
            </div>
        </div>

        <div class="gray-rect">
            <div>
                <h3>Home & Living</h3>
                <p>Upgrade your home with the latest furniture and decor items!</p>
            </div>
        </div>
    </div>
</div>