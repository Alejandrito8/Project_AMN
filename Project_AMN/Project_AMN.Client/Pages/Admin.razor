@page "/commerceAdmin"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Commerce Admin</PageTitle>
<h1 class="text-center">Commerce Dashboard </h1>

<AuthorizeView>
    <div class="text-center">
        <h3><i>As an admin...</i></h3>
        <br/>
        <hr class="border-t border-gray-300 my-4" />
    </div>
</AuthorizeView>

<div class="gray-rects">
    <div>
        <h3>Articles</h3>
        <div class="gray-rect">
        </div>
    </div>

    <div>
        <h3>Orders</h3>
        <div class="gray-rect">
        </div>
    </div>

    <div>
        <h3>Inbounds</h3>
        <div class="gray-rect">
        </div>
    </div>
</div>
