@page "/orders"
@using Project_AMN.Client.Services
@using Project_AMN.Shared.DTO
@inject OrderService OrderService
@inject ArticleService ArticleService

<h3 class="mb-4">Create Your Order</h3>

<h4 class="mb-3">Available Articles</h4>

<!-- Search and Stock Filter -->
<div class="mb-3 d-flex gap-2">
    <input type="text" @bind="searchText" placeholder="Search by name..." class="form-control" />
    <select @bind="stockFilter" class="form-select">
        <option value="">All Stock</option>
        <option value="in">In Stock</option>
        <option value="out">Out of Stock</option>
    </select>
</div>

<div class="row">
    @foreach (var article in FilteredArticles)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@article.Name</h5>
                    <p class="card-text mb-1">Price: <strong>@article.Price kr</strong></p>
                    <p class="card-text mb-3">
                        Stock:
                        @if (article.Stock > 5)
                        {
                            <span class="badge bg-success">@article.Stock</span>
                        }
                        else if (article.Stock > 0)
                        {
                            <span class="badge bg-warning text-dark">@article.Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                    </p>
                    <div class="d-flex justify-content-center mt-auto">
                        <button class="btn btn-primary btn-sm" style="min-width:120px; max-width:150px;"
                                @onclick="() => AddToCart(article)" disabled="@(!CanAddToCart(article))">
                            Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<h4 class="mt-5">Your Cart</h4>
@if (cart.Any())
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th style="width: 120px;">Quantity</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cart)
                {
                    <tr>
                        <td>@item.Article.Name</td>
                        <td>@(item.Article.Price * item.Quantity) kr</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-secondary" style="width:40px;"
                                        @onclick="() => DecreaseQuantity(item)">-</button>
                                <span class="px-2 align-self-center">@item.Quantity</span>
                                <button class="btn btn-sm btn-secondary" style="width:40px;"
                                        @onclick="() => IncreaseQuantity(item)">+</button>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" style="min-width:120px; max-width:150px;"
                                    @onclick="() => cart.Remove(item)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="fw-bold fs-5">Total Amount: @cart.Sum(i => i.Article.Price * i.Quantity) kr</p>

    <div class="d-flex justify-content-start mt-2">
        <button class="btn btn-success btn-sm" style="min-width:120px; max-width:150px;"
                @onclick="async () => await CreateOrder()">Place Order</button>
    </div>
}
else
{
    <p class="text-muted">Your cart is empty. Add some articles to create an order.</p>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

@code {
    private List<ArticleResultDto> articles = new();

    private class CartItem
    {
        public ArticleResultDto Article { get; set; } = null!;
        public int Quantity { get; set; } = 1;
    }

    private List<CartItem> cart = new();
    private string successMessage = string.Empty;

    private string searchText = string.Empty;
    private string stockFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticlesAsync();
    }

    private async Task LoadArticlesAsync()
    {
        var result = await ArticleService.GetAllArticlesAsync();
        articles = result?.Where(a => a != null).Select(a => a!).ToList() ?? new List<ArticleResultDto>();
    }

    private bool CanAddToCart(ArticleResultDto article)
    {
        var existing = cart.FirstOrDefault(c => c.Article.Id == article.Id);
        return article.Stock > 0 && (existing == null || existing.Quantity < article.Stock);
    }

    private void AddToCart(ArticleResultDto article)
    {
        var existing = cart.FirstOrDefault(c => c.Article.Id == article.Id);
        if (existing != null)
        {
            if (existing.Quantity < article.Stock)
                existing.Quantity++;
        }
        else
        {
            cart.Add(new CartItem { Article = article, Quantity = 1 });
        }
    }

    private void IncreaseQuantity(CartItem item)
    {
        var article = articles.FirstOrDefault(a => a.Id == item.Article.Id);
        if (article != null && item.Quantity < article.Stock)
        {
            item.Quantity++;
        }
    }

    private void DecreaseQuantity(CartItem item)
    {
        if (item.Quantity > 1)
            item.Quantity--;
        else
            cart.Remove(item);
    }

private async Task CreateOrder()
{
    if (!cart.Any())
    {
        successMessage = "Your cart is empty!";
        return;
    }

    var orderDto = new OrderCreateDto
    {
        TotalAmount = cart.Sum(c => c.Article.Price * c.Quantity),
        ShippingAddress = "Default Address", // Kan bytas mot inputfält
        Items = cart.Select(c => new OrderItemCreateDto
        {
            ArticleId = c.Article.Id,
            Quantity = c.Quantity,
            OrderPrice = c.Article.Price
        }).ToList()
    };

    // Skapa order och uppdatera artiklar i service
    var createdOrder = await OrderService.CreateOrderAsync(orderDto);

    if (createdOrder != null)
    {
        // Uppdatera artiklar för att visa korrekt stock direkt efter order
        var updatedArticles = await ArticleService.GetAllArticlesAsync();
        articles = updatedArticles?.Where(a => a != null).Select(a => a!).ToList() ?? new List<ArticleResultDto>();

        cart.Clear();
        successMessage = $"Order #{createdOrder.OrderId} placed successfully!";
        StateHasChanged();
    }
    else
    {
        successMessage = "Error creating order. Please try again.";
    }
}


    private IEnumerable<ArticleResultDto> FilteredArticles =>
        articles.Where(a =>
            (string.IsNullOrWhiteSpace(searchText) ||
             a.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             a.SKU.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             a.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(stockFilter) ||
             (stockFilter == "in" && a.Stock > 0) ||
             (stockFilter == "out" && a.Stock == 0))
        );
}
